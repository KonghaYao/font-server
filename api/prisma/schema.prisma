// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 字体消息模型
model FontMessage {
  id        String   @id @default(cuid())
  fontName  String
  fontHash  String   @unique
  fontUrl   String
  fontSize  Int
}

// 字体分割记录模型
model FontSplitRecord {
  id         String   @id @default(cuid())
  fontId     String
  startTime  DateTime
  logs       String
  files      String   
  endTime    DateTime?    
  error      String?      
}